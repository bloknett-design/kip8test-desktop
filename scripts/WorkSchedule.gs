  // Apps Script)
  TRAINING_EVENTSHEET_TYPES: {
    'обучение':         1,
    'прогул':           1,
    'примечание':       1
  },

  // Task 303: код слоя мероприятий (И/ОБ/ПЗ, Task 306: + ПР и *).
